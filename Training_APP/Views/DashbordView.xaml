<UserControl x:Class="Training_APP.Views.DashbordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>  <!-- Stat cards -->
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>  <!-- Water + Streak row -->
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>     <!-- Main panels -->
            </Grid.RowDefinitions>

            <!-- ======================================================= -->
            <!--  HEADER                                                   -->
            <!-- ======================================================= -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock x:Name="GreetingText"
                               Text="Good morning!"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Segoe UI Semibold"
                               FontSize="24"/>
                    <TextBlock x:Name="DateText"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Image Source="pack://application:,,,/Assets/logo.png"
                       Height="40"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <!-- ======================================================= -->
            <!--  TOP STAT CARDS                                           -->
            <!-- ======================================================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Calories consumed -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CALORIES CONSUMED"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                  />
                        <TextBlock x:Name="CaloriesConsumedText" Text="0"
                                   Foreground="{DynamicResource AccentAmberBrush}"
                                   FontFamily="Segoe UI Light" FontSize="34"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="kcal"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Margin="0,-4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Calories burned -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="CALORIES BURNED"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                  />
                        <TextBlock x:Name="CaloriesBurnedText" Text="0"
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   FontFamily="Segoe UI Light" FontSize="34"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="kcal"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Margin="0,-4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Net calories -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="NET CALORIES"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                  />
                        <TextBlock x:Name="NetCaloriesText" Text="0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Light" FontSize="34"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="NetCaloriesGoalText"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Margin="0,-4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Workouts today -->
                <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="WORKOUTS TODAY"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                  />
                        <TextBlock x:Name="WorkoutCountText" Text="0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Light" FontSize="34"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="sessions"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Margin="0,-4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================= -->
            <!--  WATER + STREAK ROW                                       -->
            <!-- ======================================================= -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Water tracker card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: label + progress -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="💧  WATER INTAKE"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI Semibold" FontSize="10"
                                           VerticalAlignment="Center"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBlock x:Name="WaterText"
                                               Foreground="#00B4D8"
                                               FontFamily="Segoe UI Semibold" FontSize="13"
                                               Text="0"/>
                                    <TextBlock x:Name="WaterGoalText"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontFamily="Segoe UI" FontSize="13"
                                               Text=" / 2500 ml"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="WaterBar"
                                         Maximum="2500" Value="0"
                                         Foreground="#00B4D8"
                                         Height="7"/>
                        </StackPanel>

                        <!-- Right: quick-add buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="+250 ml" Height="34" Padding="12,0" Margin="0,0,6,0"
                                    Style="{StaticResource GhostButton}"
                                    Tag="250" Click="Water_Click"/>
                            <Button Content="+500 ml" Height="34" Padding="12,0" Margin="0,0,6,0"
                                    Style="{StaticResource GhostButton}"
                                    Tag="500" Click="Water_Click"/>
                            <Button Content="+1 L" Height="34" Padding="12,0"
                                    Style="{StaticResource GhostButton}"
                                    Tag="1000" Click="Water_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Streak card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🔥  STREAK"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10"
                                   Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StreakText" Text="0"
                                       Foreground="{DynamicResource AccentAmberBrush}"
                                       FontFamily="Segoe UI Light" FontSize="34"/>
                            <TextBlock Text=" days"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="13"
                                       VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                        </StackPanel>
                        <TextBlock x:Name="StreakSubText" Text="consecutive days logged"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================= -->
            <!--  MAIN PANELS                                              -->
            <!-- ======================================================= -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- ─── LEFT: Calorie goal + Macros ─── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Calorie goal progress -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: large number -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="DAILY CALORIE GOAL"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI Semibold" FontSize="10"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="CaloriesRemainingText" Text="2,000"
                                               Foreground="{DynamicResource AccentAmberBrush}"
                                               FontFamily="Segoe UI Light" FontSize="52"/>
                                    <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,10">
                                        <TextBlock Text="kcal remaining"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontFamily="Segoe UI" FontSize="13"/>
                                    </StackPanel>
                                </StackPanel>
                                <ProgressBar x:Name="CalorieBar"
                                             Foreground="{DynamicResource AccentAmberBrush}"
                                             Maximum="2000" Value="0"
                                             Height="8" Margin="0,16,0,0"/>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock x:Name="CaloriesEatenLabel"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Text="0 eaten"/>
                                    <TextBlock x:Name="CaloriesGoalLabel"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontFamily="Segoe UI" FontSize="11"
                                               HorizontalAlignment="Right"
                                               Text="Goal: 2,000"/>
                                </Grid>
                            </StackPanel>

                            <!-- Divider -->
                            <Rectangle Grid.Column="1" Width="1"
                                       Fill="{DynamicResource DividerBrush}"
                                       Margin="0,8,0,8"/>

                            <!-- Right: quick formula -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="FORMULA"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI Semibold" FontSize="10"
                                           Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Eaten" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="FormulaEatenText" Text="0" Foreground="{DynamicResource AccentAmberBrush}" FontSize="12" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Burned" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="FormulaBurnedText" Text="0" Foreground="{DynamicResource AccentGreenBrush}" FontSize="12" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <TextBlock Text="Remaining" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock x:Name="FormulaRemainingText" Text="2000" Foreground="{DynamicResource AccentAmberBrush}" FontSize="12" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Macros card -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="MACRONUTRIENTS"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                       Margin="0,0,0,18"/>

                            <!-- Protein -->
                            <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="Protein" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" FontSize="13"/>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock x:Name="ProteinText" Text="0g"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Semibold" FontSize="13"/>
                                        <TextBlock x:Name="ProteinGoalText" Text=" / 150g"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontFamily="Segoe UI" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="2" x:Name="ProteinBar"
                                             Maximum="150" Value="0"
                                             Foreground="#00B4D8"/>
                            </Grid>

                            <!-- Carbs -->
                            <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="Carbohydrates" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" FontSize="13"/>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock x:Name="CarbsText" Text="0g"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Semibold" FontSize="13"/>
                                        <TextBlock x:Name="CarbsGoalText" Text=" / 250g"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontFamily="Segoe UI" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="2" x:Name="CarbsBar"
                                             Maximum="250" Value="0"
                                             Foreground="{DynamicResource AccentAmberBrush}"/>
                            </Grid>

                            <!-- Fats -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="Fats" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI" FontSize="13"/>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock x:Name="FatsText" Text="0g"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Semibold" FontSize="13"/>
                                        <TextBlock x:Name="FatsGoalText" Text=" / 65g"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontFamily="Segoe UI" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="2" x:Name="FatsBar"
                                             Maximum="65" Value="0"
                                             Foreground="{DynamicResource AccentGreenBrush}"/>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─── RIGHT: Today's meals + workouts ─── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Recent meals -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="TODAY'S MEALS"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                      />

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="160">
                                <ItemsControl x:Name="RecentFoodList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FoodName}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontFamily="Segoe UI" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding MealType}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontFamily="Segoe UI" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Calories, StringFormat={}{0} kcal}"
                                                           Foreground="{DynamicResource AccentAmberBrush}"
                                                           FontFamily="Segoe UI Semibold" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Grid.Row="3"
                                       x:Name="NoFoodText"
                                       Text="No meals logged today"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Recent workouts -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="TODAY'S WORKOUTS"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                      />

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="160">
                                <ItemsControl x:Name="RecentWorkoutList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding WorkoutName}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontFamily="Segoe UI" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DurationMinutes, StringFormat={}{0} min}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontFamily="Segoe UI" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CaloriesBurned, StringFormat={}-{0} kcal}"
                                                           Foreground="{DynamicResource AccentGreenBrush}"
                                                           FontFamily="Segoe UI Semibold" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Grid.Row="3"
                                       x:Name="NoWorkoutText"
                                       Text="No workouts logged today"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>
