<UserControl x:Class="Training_APP.Views.WorkoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ComboBox სტილი -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0f3d26"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2d6e47"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ComboBoxItem სტილი -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0f3d26"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1a5c3a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox სტილი -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0f3d26"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#2d6e47"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== სათაური ========== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🏋️ ვარჯიში"
                       Foreground="White"
                       FontFamily="Segoe UI Semibold"
                       FontSize="26"/>
            <TextBlock Text="AI-ით გააგენერირე გეგმა ან დაამატე ვარჯიში"
                       Foreground="#4a9465"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ========== კონტროლები ========== -->
        <Border Grid.Row="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Background>
                <SolidColorBrush Color="#0a2416"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15"
                                  ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- პირველი რიგი: გეგმის გენერაცია -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="LocationCombo" Grid.Column="0" Height="46">
                        <ComboBoxItem Content="🏠 სახლი" IsSelected="True"/>
                        <ComboBoxItem Content="🏋️ დარბაზი"/>
                        <ComboBoxItem Content="🌳 გარეთ"/>
                    </ComboBox>

                    <ComboBox x:Name="DaysCombo" Grid.Column="2" Height="46">
                        <ComboBoxItem Content="3 დღე კვირაში" IsSelected="True"/>
                        <ComboBoxItem Content="4 დღე კვირაში"/>
                        <ComboBoxItem Content="5 დღე კვირაში"/>
                        <ComboBoxItem Content="6 დღე კვირაში"/>
                    </ComboBox>

                    <ComboBox x:Name="GoalCombo" Grid.Column="4" Height="46">
                        <ComboBoxItem Content="💪 კუნთის მომატება" IsSelected="True"/>
                        <ComboBoxItem Content="🔥 წონის დაკლება"/>
                        <ComboBoxItem Content="🏃 გამძლეობა"/>
                        <ComboBoxItem Content="⚖️ ფორმის შენარჩუნება"/>
                    </ComboBox>

                    <Button Grid.Column="6" Content="🤖 გეგმის გენერაცია"
                            Click="GeneratePlan_Click"
                            Height="46" Padding="16,0"
                            Cursor="Hand"
                            FontFamily="Segoe UI Semibold" FontSize="13"
                            Foreground="White" BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1a5c3a" Offset="0"/>
                                <GradientStop Color="#2d8a57" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- მეორე რიგი: ვარჯიშის დამატება -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="WorkoutNameBox" Grid.Column="0"
                             Height="46" Padding="12,10"/>

                    <TextBox x:Name="DurationBox" Grid.Column="2"
                             Height="46" Padding="12,10"/>

                    <ComboBox x:Name="IntensityCombo" Grid.Column="4" Height="46">
                        <ComboBoxItem Content="🟢 დაბალი"/>
                        <ComboBoxItem Content="🟡 საშუალო" IsSelected="True"/>
                        <ComboBoxItem Content="🔴 მაღალი"/>
                    </ComboBox>

                    <Button Grid.Column="6" Content="+ დამატება"
                            Click="AddWorkout_Click"
                            Height="46" Padding="16,0"
                            Cursor="Hand"
                            FontFamily="Segoe UI Semibold" FontSize="13"
                            Foreground="White" BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1a5c3a" Offset="0"/>
                                <GradientStop Color="#2d8a57" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ========== კონტენტი ========== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- AI გეგმა -->
            <Border Grid.Column="0" CornerRadius="12" Padding="20">
                <Border.Background>
                    <SolidColorBrush Color="#0a2416"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="15"
                                      ShadowDepth="2" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🤖 AI გეგმა"
                               Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold"
                               FontSize="14" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PlanText"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="გეგმის გენერაციისთვის აირჩიე პარამეტრები და დააჭირე ღილაკს ⬆️"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- დღის ვარჯიშები -->
            <Border Grid.Column="2" CornerRadius="12" Padding="16">
                <Border.Background>
                    <SolidColorBrush Color="#0a2416"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="15"
                                      ShadowDepth="2" Opacity="0.4"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 დღის ვარჯიშები"
                               Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold"
                               FontSize="14" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WorkoutList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,10"
                                            Margin="0,0,0,8"
                                            Background="#0f3d26">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding WorkoutName}"
                                                           Foreground="White"
                                                           FontFamily="Segoe UI Semibold"
                                                           FontSize="13"/>
                                                <TextBlock Foreground="#4a9465"
                                                           FontFamily="Segoe UI"
                                                           FontSize="11">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} წთ • {1} კალ • {2}">
                                                            <Binding Path="DurationMinutes"/>
                                                            <Binding Path="CaloriesBurned"/>
                                                            <Binding Path="Intensity"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🗑️"
                                                    Tag="{Binding Id}"
                                                    Click="DeleteWorkout_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    FontSize="16"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>