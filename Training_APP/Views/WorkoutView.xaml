<UserControl x:Class="Training_APP.Views.WorkoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBgBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────── -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Workout"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="Segoe UI Semibold" FontSize="24"/>
                <TextBlock Text="Generate an AI plan or log today's session"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ── Tab bar ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <RadioButton x:Name="TabPlan"
                         Content="🤖  AI Workout Plan"
                         Style="{StaticResource WorkoutTab}"
                         IsChecked="True"
                         Checked="Tab_Checked"/>
            <RadioButton x:Name="TabLog"
                         Content="📋  Today's Log"
                         Style="{StaticResource WorkoutTab}"
                         Checked="Tab_Checked"
                         Margin="8,0,0,0"/>
            <RadioButton x:Name="TabHistory"
                         Content="📅  History"
                         Style="{StaticResource WorkoutTab}"
                         Checked="Tab_Checked"
                         Margin="8,0,0,0"/>
        </StackPanel>

        <!-- ── Tab content ─────────────────────────────────────────── -->
        <Grid Grid.Row="4">

            <!-- ══════════════════════════════════════════════════════ -->
            <!--  TAB 1 — AI PLAN                                       -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Grid x:Name="PlanTab">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Options card -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>

                        <!-- Row 1: Location · Days · Equipment -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="LocationCombo" Grid.Column="0" Height="44">
                                <ComboBoxItem Content="🏠  Home" IsSelected="True"/>
                                <ComboBoxItem Content="🏋  Gym"/>
                                <ComboBoxItem Content="🌳  Outdoors"/>
                            </ComboBox>

                            <ComboBox x:Name="DaysCombo" Grid.Column="2" Height="44">
                                <ComboBoxItem Content="3 days / week" IsSelected="True"/>
                                <ComboBoxItem Content="4 days / week"/>
                                <ComboBoxItem Content="5 days / week"/>
                                <ComboBoxItem Content="6 days / week"/>
                            </ComboBox>

                            <!-- Equipment input with placeholder -->
                            <Grid Grid.Column="4">
                                <TextBox x:Name="EquipmentBox" Height="44" Padding="12,10"/>
                                <TextBlock Text="Equipment (e.g. dumbbells, barbell, resistance bands)"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Opacity="0.5"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=EquipmentBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!-- Row 2: Goals (multi-select) + Generate button -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="GOALS  (pick one or more)"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI Semibold" FontSize="10"
                                           Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <CheckBox x:Name="GoalMuscle"    Content="💪  Muscle Gain"  Margin="0,0,20,0" IsChecked="True"/>
                                    <CheckBox x:Name="GoalFatLoss"   Content="🔥  Fat Loss"     Margin="0,0,20,0"/>
                                    <CheckBox x:Name="GoalEndurance" Content="🏃  Endurance"    Margin="0,0,20,0"/>
                                    <CheckBox x:Name="GoalMaintain"  Content="⚖️  Maintenance"/>
                                </WrapPanel>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="✨  Generate Plan"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44" Padding="18,0"
                                    VerticalAlignment="Bottom"
                                    Click="GeneratePlan_Click"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Plan text card -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="YOUR PERSONALIZED PLAN"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"/>
                            <TextBlock x:Name="PlanDateBadge"
                                       Foreground="{DynamicResource AccentGreenBrush}"
                                       FontFamily="Segoe UI" FontSize="11"
                                       HorizontalAlignment="Right"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource DividerBrush}"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PlanText"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI" FontSize="13"
                                       TextWrapping="Wrap"
                                       LineHeight="24"
                                       Text="Set your preferences above and click ✨ Generate Plan to get a personalized AI workout plan."/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════ -->
            <!--  TAB 2 — TODAY'S LOG                                   -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Grid x:Name="LogTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Add workout row -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Workout name with placeholder -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="WorkoutNameBox" Height="44" Padding="12,10"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Background="{DynamicResource InputBrush}"/>
                            <TextBlock Text="Workout name (e.g. Running, Bench Press)"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Margin="13,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=WorkoutNameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Duration with placeholder -->
                        <Grid Grid.Column="2">
                            <TextBox x:Name="DurationBox" Height="44" Padding="12,10"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Background="{DynamicResource InputBrush}"/>
                            <TextBlock Text="Minutes"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Margin="13,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=DurationBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox x:Name="IntensityCombo" Grid.Column="4" Height="44">
                            <ComboBoxItem Content="🟢  Low"/>
                            <ComboBoxItem Content="🟡  Medium" IsSelected="True"/>
                            <ComboBoxItem Content="🔴  High"/>
                        </ComboBox>

                        <Button Grid.Column="6"
                                Content="+ Log Workout"
                                Style="{StaticResource PrimaryButton}"
                                Height="44" Padding="18,0"
                                Click="AddWorkout_Click"/>
                    </Grid>
                </Border>

                <!-- Workout list -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="WORKOUT"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"/>
                            <TextBlock Grid.Column="1" Text="DURATION"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="INTENSITY"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="KCAL BURNED"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource DividerBrush}"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="WorkoutList" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="12,12"
                                                    Margin="0,0,0,6"
                                                    Background="{DynamicResource InputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding WorkoutName}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontFamily="Segoe UI Semibold" FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DurationMinutes, StringFormat={}{0} min}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontFamily="Segoe UI" FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Intensity}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontFamily="Segoe UI" FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding CaloriesBurned, StringFormat={}{0} kcal}"
                                                               Foreground="{DynamicResource AccentGreenBrush}"
                                                               FontFamily="Segoe UI Semibold" FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="4"
                                                            Content="✕"
                                                            Tag="{Binding Id}"
                                                            Style="{StaticResource IconButton}"
                                                            Click="DeleteWorkout_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="EmptyLogText"
                                           Text="No workouts logged today — add one above"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI" FontSize="13"
                                           HorizontalAlignment="Center"
                                           Margin="0,24,0,0"
                                           Visibility="Visible"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════ -->
            <!--  TAB 3 — HISTORY (last 7 days)                        -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Grid x:Name="HistoryTab" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DATE"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"/>
                            <TextBlock Grid.Column="1" Text="WORKOUT"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"/>
                            <TextBlock Grid.Column="2" Text="DURATION"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="INTENSITY"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="KCAL BURNED"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource DividerBrush}"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl x:Name="HistoryList" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="12,10"
                                                    Margin="0,0,0,6"
                                                    Background="{DynamicResource InputBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Date, StringFormat={}{0:MMM d}}"
                                                               Foreground="{DynamicResource AccentGreenBrush}"
                                                               FontFamily="Segoe UI Semibold" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding WorkoutName}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontFamily="Segoe UI Semibold" FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DurationMinutes, StringFormat={}{0} min}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontFamily="Segoe UI" FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Intensity}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontFamily="Segoe UI" FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding CaloriesBurned, StringFormat={}{0} kcal}"
                                                               Foreground="{DynamicResource AccentGreenBrush}"
                                                               FontFamily="Segoe UI Semibold" FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="EmptyHistoryText"
                                           Text="No workouts in the past 7 days — start logging!"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI" FontSize="13"
                                           HorizontalAlignment="Center"
                                           Margin="0,24,0,0"
                                           Visibility="Visible"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
