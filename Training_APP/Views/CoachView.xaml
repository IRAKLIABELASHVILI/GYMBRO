<UserControl x:Class="Training_APP.Views.CoachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== სათაური ========== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="💬 AI Coach"
                       Foreground="White"
                       FontFamily="Segoe UI Semibold"
                       FontSize="26"/>
            <TextBlock Text="კითხე ნებისმიერი კვების ან ვარჯიშის შესახებ"
                       Foreground="#4a9465"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ========== ჩატის ზონა ========== -->
        <Border Grid.Row="1" CornerRadius="12" Padding="16">
            <Border.Background>
                <SolidColorBrush Color="#0a2416"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15"
                                  ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <ScrollViewer x:Name="ChatScroll"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel" Margin="8"/>
            </ScrollViewer>
        </Border>

        <!-- ========== შეტყობინების ველი ========== -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- თემის არჩევა -->
            <ComboBox x:Name="TopicCombo"
                      Grid.Column="0"
                      Width="130" Height="46"
                      Margin="0,0,10,0"
                      Background="#0f3d26"
                      Foreground="White"
                      BorderBrush="#2d6e47"
                      FontFamily="Segoe UI"
                      FontSize="13">
                <ComboBoxItem Content="🥗 კვება" IsSelected="True"/>
                <ComboBoxItem Content="🏋️ ვარჯიში"/>
            </ComboBox>

            <!-- ტექსტის ველი -->
            <Border Grid.Column="1" CornerRadius="10"
                    BorderBrush="#2d6e47" BorderThickness="1">
                <TextBox x:Name="MessageBox"
                         Background="#0a2416"
                         Foreground="White"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         Padding="14,12"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         TextWrapping="Wrap"
                         AcceptsReturn="False">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Border>

            <!-- გაგზავნის ღილაკი -->
            <Button Grid.Column="2"
                    Content="გაგზავნა ➤"
                    Click="SendMessage_Click"
                    Width="110" Height="46"
                    Margin="10,0,0,0"
                    Cursor="Hand"
                    FontFamily="Segoe UI Semibold"
                    FontSize="13"
                    Foreground="White"
                    BorderThickness="0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1a5c3a" Offset="0"/>
                        <GradientStop Color="#2d8a57" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="16,0">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>
    </Grid>
</UserControl>