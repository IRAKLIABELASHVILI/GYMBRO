<UserControl x:Class="Training_APP.Views.CoachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBgBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="AI Coach"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontFamily="Segoe UI Semibold" FontSize="24"/>
            <TextBlock Text="Ask anything about your nutrition or training"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="Segoe UI" FontSize="13" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Chat area -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel" Margin="4"/>
            </ScrollViewer>
        </Border>

        <!-- Input row -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="TopicCombo" Grid.Column="0" Height="48">
                <ComboBoxItem Content="🥗  Nutrition" IsSelected="True"/>
                <ComboBoxItem Content="🏋  Workout"/>
            </ComboBox>

            <TextBox x:Name="MessageBox" Grid.Column="2" Height="48"
                     Padding="14,0" FontSize="14"
                     VerticalContentAlignment="Center"
                     KeyDown="MessageBox_KeyDown"/>

            <Button Grid.Column="4"
                    Content="Send  ➤"
                    Style="{StaticResource PrimaryButton}"
                    Height="48"
                    Click="SendMessage_Click"/>
        </Grid>
    </Grid>
</UserControl>
