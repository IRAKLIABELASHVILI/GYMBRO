<Window x:Class="Training_APP.Views.FoodGramsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Food"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        ResizeMode="NoResize">

    <StackPanel Margin="28,24,28,28">

        <!-- Food name heading -->
        <TextBlock x:Name="FoodNameText"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontFamily="Segoe UI Semibold"
                   FontSize="20"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>

        <TextBlock Text="Review and adjust the details before calculating nutrition."
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,24"/>

        <!-- Food name field -->
        <TextBlock Text="FOOD NAME"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontFamily="Segoe UI Semibold"
                   FontSize="10"
                   Margin="0,0,0,8"/>
        <TextBox x:Name="NameBox"
                 Height="44" Padding="12,0"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,16"/>

        <!-- Grams field -->
        <TextBlock Text="AMOUNT (grams)"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontFamily="Segoe UI Semibold"
                   FontSize="10"
                   Margin="0,0,0,8"/>
        <TextBox x:Name="GramsBox"
                 Height="44" Padding="12,0"
                 VerticalContentAlignment="Center"
                 Margin="0,0,0,24"/>

        <!-- Confirm button -->
        <Button Content="Calculate Nutrition  ➤"
                Click="Confirm_Click"
                Height="46"
                Style="{StaticResource PrimaryButton}"/>

    </StackPanel>
</Window>
