<UserControl x:Class="Training_APP.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Profile"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="Segoe UI Semibold" FontSize="24"/>
                <TextBlock Text="Your data powers AI-personalized nutrition and workout plans"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Avatar + stat cards -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                        Background="{DynamicResource AccentGreenBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="AvatarInitials" Text="?"
                               Foreground="#0B0D14"
                               FontFamily="Segoe UI Semibold" FontSize="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- BMI -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="BMI" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,4"/>
                        <TextBlock x:Name="BmiText" Text="—"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Light" FontSize="32"/>
                        <TextBlock x:Name="BmiCategory" Text="Fill in weight &amp; height"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Calorie goal -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="DAILY CALORIES" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CalorieGoalText" Text="—"
                                   Foreground="{DynamicResource AccentAmberBrush}"
                                   FontFamily="Segoe UI Light" FontSize="32"/>
                        <TextBlock Text="kcal / day" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Goal -->
                <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="FITNESS GOAL" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,4"/>
                        <TextBlock x:Name="GoalSummaryText" Text="—"
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Form -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Name / Age / Gender -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="FULL NAME" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,8"/>
                        <TextBox x:Name="NameBox" Height="44" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="Name_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="AGE" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,8"/>
                        <TextBox x:Name="AgeBox" Height="44" Padding="12,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4">
                        <TextBlock Text="GENDER" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,8"/>
                        <ComboBox x:Name="GenderCombo" Height="44">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Weight / Height / Activity -->
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="WEIGHT (kg)" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,8"/>
                        <TextBox x:Name="WeightBox" Height="44" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="PhysicalStats_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="HEIGHT (cm)" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,8"/>
                        <TextBox x:Name="HeightBox" Height="44" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="PhysicalStats_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="4">
                        <TextBlock Text="ACTIVITY LEVEL" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,8"/>
                        <ComboBox x:Name="ActivityCombo" Height="44">
                            <ComboBoxItem Content="Beginner"/>
                            <ComboBoxItem Content="Intermediate"/>
                            <ComboBoxItem Content="Advanced"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Goal full width -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5">
                        <TextBlock Text="FITNESS GOAL" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,0,0,8"/>
                        <ComboBox x:Name="GoalCombo" Height="44">
                            <ComboBoxItem Content="Weight Loss"/>
                            <ComboBoxItem Content="Muscle Gain"/>
                            <ComboBoxItem Content="Improve Endurance"/>
                            <ComboBoxItem Content="Maintain Weight"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Macro targets card -->
            <Border Grid.Row="6" x:Name="TdeeCard" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentGreenBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20"
                    Background="{DynamicResource TdeeCardBgBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="PROTEIN" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TdeeProtein" Foreground="#00B4D8"
                                   FontFamily="Segoe UI Light" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="g / day" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="CARBS" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TdeeCarbs" Foreground="{DynamicResource AccentAmberBrush}"
                                   FontFamily="Segoe UI Light" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="g / day" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="FATS" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TdeeFats" Foreground="{DynamicResource AccentGreenBrush}"
                                   FontFamily="Segoe UI Light" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="g / day" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Save -->
            <Button Grid.Row="8"
                    Content="Save &amp; Recalculate Goals"
                    Style="{StaticResource PrimaryButton}"
                    Height="48"
                    Click="SaveProfile_Click"/>

            <!-- Weight Log -->
            <Border Grid.Row="10" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="WEIGHT TRACKER"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI Semibold" FontSize="10"/>
                            <TextBlock x:Name="WeightTrendText"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Margin="0,2,0,0"
                                       Text="Log your weight daily to see your trend"/>
                        </StackPanel>
                        <TextBlock x:Name="TodayWeightBadge"
                                   Foreground="{DynamicResource AccentGreenBrush}"
                                   FontFamily="Segoe UI Semibold" FontSize="13"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource DividerBrush}"/>

                    <!-- Log input row -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="WeightLogBox"
                                     Height="44" Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Background="{DynamicResource InputBrush}"/>
                            <TextBlock Text="Today's weight (kg)"
                                       Foreground="#3A4055"
                                       FontFamily="Segoe UI" FontSize="12"
                                       Margin="13,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=WeightLogBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2"
                                Content="+ Log Weight"
                                Style="{StaticResource PrimaryButton}"
                                Height="44" Padding="18,0"
                                Click="LogWeight_Click"/>
                    </Grid>

                    <!-- Chart canvas -->
                    <Canvas x:Name="WeightChart" Grid.Row="4"
                            Background="{DynamicResource InputBrush}"
                            ClipToBounds="True"/>

                    <!-- X-axis date labels -->
                    <ItemsControl x:Name="ChartDateLabels" Grid.Row="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
