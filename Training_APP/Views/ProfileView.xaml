<UserControl x:Class="Training_APP.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== სათაური ========== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="👤 პროფილი"
                       Foreground="White"
                       FontFamily="Segoe UI Semibold"
                       FontSize="26"/>
            <TextBlock Text="შეიყვანე შენი მონაცემები სწორი გათვლებისთვის"
                       Foreground="#4a9465"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ========== ფორმა ========== -->
        <Border Grid.Row="1" CornerRadius="12" Padding="30">
            <Border.Background>
                <SolidColorBrush Color="#0a2416"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15"
                                  ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- სახელი -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="სახელი" Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold" FontSize="12" Margin="0,0,0,6"/>
                    <Border CornerRadius="8" BorderBrush="#2d6e47" BorderThickness="1">
                        <TextBox x:Name="NameBox" Background="#0f3d26" Foreground="White"
                                 FontFamily="Segoe UI" FontSize="14" Padding="12,10"
                                 BorderThickness="0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                </StackPanel>

                <!-- ასაკი -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="ასაკი" Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold" FontSize="12" Margin="0,0,0,6"/>
                    <Border CornerRadius="8" BorderBrush="#2d6e47" BorderThickness="1">
                        <TextBox x:Name="AgeBox" Background="#0f3d26" Foreground="White"
                                 FontFamily="Segoe UI" FontSize="14" Padding="12,10"
                                 BorderThickness="0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                </StackPanel>

                <!-- წონა -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="წონა (კგ)" Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold" FontSize="12" Margin="0,0,0,6"/>
                    <Border CornerRadius="8" BorderBrush="#2d6e47" BorderThickness="1">
                        <TextBox x:Name="WeightBox" Background="#0f3d26" Foreground="White"
                                 FontFamily="Segoe UI" FontSize="14" Padding="12,10"
                                 BorderThickness="0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                </StackPanel>

                <!-- სიმაღლე -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="სიმაღლე (სმ)" Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold" FontSize="12" Margin="0,0,0,6"/>
                    <Border CornerRadius="8" BorderBrush="#2d6e47" BorderThickness="1">
                        <TextBox x:Name="HeightBox" Background="#0f3d26" Foreground="White"
                                 FontFamily="Segoe UI" FontSize="14" Padding="12,10"
                                 BorderThickness="0">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                </StackPanel>

                <!-- სქესი -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                    <TextBlock Text="სქესი" Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold" FontSize="12" Margin="0,0,0,6"/>
                    <Border CornerRadius="8" BorderBrush="#2d6e47" BorderThickness="1"
                            Background="#0f3d26">
                        <ComboBox x:Name="GenderCombo" Background="Transparent"
                                  Foreground="White" BorderThickness="0"
                                  FontFamily="Segoe UI" FontSize="14" Padding="12,10">
                            <ComboBoxItem Content="მამრობითი"/>
                            <ComboBoxItem Content="მდედრობითი"/>
                        </ComboBox>
                    </Border>
                </StackPanel>

                <!-- აქტივობა -->
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                    <TextBlock Text="აქტივობის დონე" Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold" FontSize="12" Margin="0,0,0,6"/>
                    <Border CornerRadius="8" BorderBrush="#2d6e47" BorderThickness="1"
                            Background="#0f3d26">
                        <ComboBox x:Name="ActivityCombo" Background="Transparent"
                                  Foreground="White" BorderThickness="0"
                                  FontFamily="Segoe UI" FontSize="14" Padding="12,10">
                            <ComboBoxItem Content="დამწყები"/>
                            <ComboBoxItem Content="საშუალო"/>
                            <ComboBoxItem Content="მოწინავე"/>
                        </ComboBox>
                    </Border>
                </StackPanel>

                <!-- მიზანი -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                    <TextBlock Text="მიზანი" Foreground="#4a9465"
                               FontFamily="Segoe UI Semibold" FontSize="12" Margin="0,0,0,6"/>
                    <Border CornerRadius="8" BorderBrush="#2d6e47" BorderThickness="1"
                            Background="#0f3d26">
                        <ComboBox x:Name="GoalCombo" Background="Transparent"
                                  Foreground="White" BorderThickness="0"
                                  FontFamily="Segoe UI" FontSize="14" Padding="12,10">
                            <ComboBoxItem Content="წონის დაკლება"/>
                            <ComboBoxItem Content="კუნთის მომატება"/>
                            <ComboBoxItem Content="გამძლეობის გაზრდა"/>
                            <ComboBoxItem Content="ფორმის შენარჩუნება"/>
                        </ComboBox>
                    </Border>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ========== შენახვის ღილაკი ========== -->
        <Button Grid.Row="2" Content="შენახვა ✓"
                Click="SaveProfile_Click"
                Height="48" Margin="0,16,0,0"
                Cursor="Hand"
                FontFamily="Segoe UI Semibold"
                FontSize="15"
                Foreground="White"
                BorderThickness="0">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1a5c3a" Offset="0"/>
                    <GradientStop Color="#2d8a57" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</UserControl>