<UserControl x:Class="Training_APP.Views.FoodLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== სათაური ========== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🥗 საჭმლის ლოგი"
                       Foreground="White"
                       FontFamily="Segoe UI Semibold"
                       FontSize="26"/>
            <TextBlock Text="ფოტოთი ან ხელით დაამატე საჭმელი"
                       Foreground="#4a9465"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ========== დამატების ზონა ========== -->
        <Border Grid.Row="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Background>
                <SolidColorBrush Color="#0a2416"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15"
                                  ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ფოტოს ღილაკი -->
                <Button Grid.Column="0" Content="📷  ფოტოს ატვირთვა"
                        Click="UploadPhoto_Click"
                        Height="46" Cursor="Hand"
                        FontFamily="Segoe UI Semibold" FontSize="13"
                        Foreground="White" BorderThickness="0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1a5c3a" Offset="0"/>
                            <GradientStop Color="#2d8a57" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- კვების ტიპი -->
                <Border Grid.Column="2" CornerRadius="8"
                        BorderBrush="#2d6e47" BorderThickness="1"
                        Background="#0f3d26">
                    <ComboBox x:Name="MealTypeCombo"
                              Background="Transparent" Foreground="White"
                              BorderThickness="0" FontFamily="Segoe UI"
                              FontSize="13" Padding="12,10">
                        <ComboBoxItem Content="🌅 საუზმე" IsSelected="True"/>
                        <ComboBoxItem Content="☀️ სადილი"/>
                        <ComboBoxItem Content="🌙 ვახშამი"/>
                        <ComboBoxItem Content="🍎 სნეკი"/>
                    </ComboBox>
                </Border>

                <!-- სტატუსი -->
                <TextBlock Grid.Column="4" x:Name="StatusText"
                           Foreground="#4a9465"
                           FontFamily="Segoe UI" FontSize="13"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- ========== საჭმლის სია ========== -->
        <Border Grid.Row="2" CornerRadius="12" Padding="16">
            <Border.Background>
                <SolidColorBrush Color="#0a2416"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15"
                                  ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- სვეტების სათაური -->
                <Grid Grid.Row="0" Margin="8,0,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="საჭმელი" Foreground="#4a9465" FontFamily="Segoe UI Semibold" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="კალ" Foreground="#4a9465" FontFamily="Segoe UI Semibold" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="ცილა" Foreground="#4a9465" FontFamily="Segoe UI Semibold" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="ნახშირწყალი" Foreground="#4a9465" FontFamily="Segoe UI Semibold" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="ცხიმი" Foreground="#4a9465" FontFamily="Segoe UI Semibold" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="" Foreground="#4a9465" FontFamily="Segoe UI Semibold" FontSize="12"/>
                </Grid>

                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="8,0,8,0">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="#1a3d28"/>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- სია -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="FoodList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,10"
                                        Margin="0,4,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0f3d26"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FoodName}" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="13"/>
                                            <TextBlock Text="{Binding MealType}" Foreground="#4a9465" FontFamily="Segoe UI" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Calories}" Foreground="White" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Protein, StringFormat={}{0:F1}გ}" Foreground="White" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Carbohydrates, StringFormat={}{0:F1}გ}" Foreground="White" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Fats, StringFormat={}{0:F1}გ}" Foreground="White" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Grid.Column="5" Content="🗑️"
                                                Tag="{Binding Id}"
                                                Click="DeleteFood_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontSize="16"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>