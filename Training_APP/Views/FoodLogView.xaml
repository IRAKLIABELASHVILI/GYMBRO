<UserControl x:Class="Training_APP.Views.FoodLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBgBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Food Log"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="Segoe UI Semibold" FontSize="24"/>
                <TextBlock Text="Upload a photo or log food manually"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="Segoe UI" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource AccentGreenBrush}"
                       FontFamily="Segoe UI" FontSize="13"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- ADD FOOD PANEL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- AI Photo Drop Zone -->
            <Border Grid.Column="0"
                    x:Name="DropZoneBorder"
                    Background="{DynamicResource DropZoneBgBrush}"
                    BorderBrush="{DynamicResource DropZoneBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    AllowDrop="True"
                    Cursor="Hand"
                    MinHeight="130"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    Drop="DropZone_Drop"
                    MouseLeftButtonDown="DropZone_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📷" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DropPrimaryText"
                               Text="Drop a food photo here"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="14"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="or click to browse"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Text="AI will identify the food and calculate nutrition"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.4"
                               FontFamily="Segoe UI" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Meal type + Manual entry -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="MEAL TYPE"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="MealTypeCombo" Height="42" Margin="0,0,0,16">
                        <ComboBoxItem Content="Breakfast" IsSelected="True"/>
                        <ComboBoxItem Content="Lunch"/>
                        <ComboBoxItem Content="Dinner"/>
                        <ComboBoxItem Content="Snack"/>
                    </ComboBox>

                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="MANUAL ENTRY"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               Margin="0,0,0,10"/>

                    <!-- Food name with placeholder -->
                    <Grid Margin="0,0,0,10">
                        <TextBox x:Name="ManualFoodBox" Height="42" Padding="12,10"/>
                        <TextBlock Text="Food name (e.g. banana)"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Opacity="0.5"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ManualFoodBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Grams with placeholder -->
                    <Grid Margin="0,0,0,12">
                        <TextBox x:Name="ManualGramsBox" Height="42" Padding="12,10"/>
                        <TextBlock Text="Amount in grams (e.g. 150)"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Opacity="0.5"
                                   FontFamily="Segoe UI" FontSize="12"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ManualGramsBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Content="Calculate &amp; Add"
                            Style="{StaticResource PrimaryButton}"
                            Height="42"
                            Click="AddManual_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOD LIST -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column header -->
                <Grid Grid.Row="0" Margin="20,16,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="FOOD"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="10"/>
                    <TextBlock Grid.Column="1" Text="KCAL"
                               Foreground="{DynamicResource AccentAmberBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="PROTEIN"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="CARBS"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="FATS"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontFamily="Segoe UI Semibold" FontSize="10"
                               HorizontalAlignment="Center"/>
                </Grid>

                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                           Margin="20,0,20,0" Fill="{DynamicResource DividerBrush}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="FoodList" Margin="8,4,8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="12,10" Margin="0,2,0,0"
                                            Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource InputBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FoodName}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontFamily="Segoe UI Semibold" FontSize="13"/>
                                                <TextBlock Text="{Binding MealType}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontFamily="Segoe UI" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Calories}"
                                                       Foreground="{DynamicResource AccentAmberBrush}"
                                                       FontFamily="Segoe UI Semibold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Protein, StringFormat={}{0:F1}g}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="Segoe UI" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Carbohydrates, StringFormat={}{0:F1}g}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="Segoe UI" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Fats, StringFormat={}{0:F1}g}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="Segoe UI" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Grid.Column="5" Content="✕"
                                                    Tag="{Binding Id}"
                                                    Style="{StaticResource IconButton}"
                                                    Click="DeleteFood_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyFoodText"
                                   Text="No food logged today — drop a photo or add manually"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,24,0,24"
                                   Visibility="Visible"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
