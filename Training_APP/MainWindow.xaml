<Window x:Class="Training_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Training APP" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== გვერდითი მენიუ ========== -->
        <StackPanel Grid.Column="0" Background="#181825" VerticalAlignment="Stretch">

            <!-- სათაური -->
            <TextBlock Text="🏋️ Training APP"
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       Margin="20,30,20,40" TextWrapping="Wrap"/>

            <!-- მენიუს ღილაკები -->
            <Button Content="📊  Dashboard"  Click="NavDashboard_Click"  Style="{StaticResource NavButton}"/>
            <Button Content="🥗  საჭმელი"    Click="NavFood_Click"       Style="{StaticResource NavButton}"/>
            <Button Content="🏋️  ვარჯიში"    Click="NavWorkout_Click"    Style="{StaticResource NavButton}"/>
            <Button Content="💬  AI Coach"   Click="NavCoach_Click"      Style="{StaticResource NavButton}"/>
            <Button Content="👤  პროფილი"    Click="NavProfile_Click"    Style="{StaticResource NavButton}"/>

        </StackPanel>

        <!-- ========== მთავარი კონტენტი ========== -->
        <ContentControl Grid.Column="1" x:Name="MainContent"/>

    </Grid>
</Window>