<Window x:Class="Training_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gymbro" Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================= -->
        <!--  SIDEBAR                                                 -->
        <!-- ======================================================= -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Logo area -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,0">
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Height="48"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <!-- Divider -->
                <Rectangle DockPanel.Dock="Top"
                           Height="1" Margin="20,20,20,8"
                           Fill="{DynamicResource DividerBrush}"/>

                <!-- Nav label -->
                <TextBlock DockPanel.Dock="Top"
                           Text="MENU"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="Segoe UI Semibold"
                           FontSize="10"
                           Opacity="0.5"
                           Margin="22,4,0,8"/>

                <!-- Navigation items -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavDashboard"
                                 Content="📊   Dashboard"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavDashboard_Checked"/>
                    <RadioButton x:Name="NavFood"
                                 Content="🥗   Food Log"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavFood_Checked"/>
                    <RadioButton x:Name="NavWorkout"
                                 Content="🏋   Workout"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavWorkout_Checked"/>
                    <RadioButton x:Name="NavCoach"
                                 Content="💬   AI Coach"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavCoach_Checked"/>
                    <RadioButton x:Name="NavProfile"
                                 Content="👤   Profile"
                                 Style="{StaticResource NavItem}"
                                 Checked="NavProfile_Checked"/>
                </StackPanel>

                <!-- Bottom: theme toggle + version -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16">
                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,12"/>

                    <!-- Theme toggle button -->
                    <Button x:Name="ThemeToggleBtn"
                            Content="☀️  Light Mode"
                            Click="ThemeToggle_Click"
                            Style="{StaticResource GhostButton}"
                            Height="38"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"/>

                    <TextBlock Text="Gymbro v1.0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.3"
                               FontFamily="Segoe UI" FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ======================================================= -->
        <!--  MAIN CONTENT AREA                                       -->
        <!-- ======================================================= -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="{DynamicResource AppBgBrush}"/>
    </Grid>
</Window>
