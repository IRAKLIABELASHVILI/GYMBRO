<Window x:Class="Training_APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gymbro" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#111916">

    <Window.Resources>

        <!-- ================================ -->
        <!-- NAV BUTTON STYLE -->
        <!-- ================================ -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8dab98"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="24,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Margin="10,2,10,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a3d28"/>
                                <Setter Property="Foreground" Value="#6fcf97"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0f2a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== გვერდითი მენიუ ========== -->
        <Border Grid.Column="0" CornerRadius="0,0,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0a2416" Offset="0"/>
                    <GradientStop Color="#0f3d26" Offset="0.5"/>
                    <GradientStop Color="#0a2416" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel>

                <!-- ლოგო ზონა -->
                <Border Margin="18,24,18,8" CornerRadius="12" Padding="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20"
                                          ShadowDepth="4" Opacity="0.5"/>
                    </Border.Effect>
                    <Image Source="Assets/logo.png"
                           Height="75"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"/>
                </Border>

                <!-- სლოგანი -->
                <TextBlock Text="Train Smart. Eat Right."
                           Foreground="#4a9465"
                           FontFamily="Segoe UI"
                           FontStyle="Italic"
                           FontSize="11"
                           Margin="26,0,20,20"/>

                <!-- გამყოფი -->
                <Rectangle Height="1" Margin="18,0,18,12">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#2d6e47" Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- მენიუს ღილაკები -->
                <Button Content="📊   Dashboard"  Click="NavDashboard_Click" Style="{StaticResource NavButton}"/>
                <Button Content="🥗   საჭმელი"    Click="NavFood_Click"      Style="{StaticResource NavButton}"/>
                <Button Content="🏋️   ვარჯიში"    Click="NavWorkout_Click"   Style="{StaticResource NavButton}"/>
                <Button Content="💬   AI Coach"   Click="NavCoach_Click"     Style="{StaticResource NavButton}"/>
                <Button Content="👤   პროფილი"    Click="NavProfile_Click"   Style="{StaticResource NavButton}"/>

            </StackPanel>
        </Border>

        <!-- ========== მთავარი კონტენტი ========== -->
        <Border Grid.Column="1" BorderThickness="1,0,0,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1a3d28" Offset="0"/>
                    <GradientStop Color="#0f2a1a" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#111916" Offset="0"/>
                    <GradientStop Color="#0d1f14" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <ContentControl x:Name="MainContent"/>
        </Border>

    </Grid>
</Window>